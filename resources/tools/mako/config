# Written by Pila (`tool-configs`): Pila's [colors] and text size, square
# corners. Pila writes it at every start and when [colors] changes: to change
# it, copy it to ~/.config, which the tool then reads instead.

font=sans-serif 14px
background-color=#@bar-inactive@
text-color=#@icon@
border-color=#@hover@
border-size=1
border-radius=0
progress-color=over #@snap-preview@
width=360
padding=10
margin=12
default-timeout=5000

[urgency=high]
border-color=#@close-hover@
default-timeout=0
